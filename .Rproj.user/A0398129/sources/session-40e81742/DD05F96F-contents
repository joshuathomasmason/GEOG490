```

```{r}
aian_2020 <- get_decennial(
  geography = "state",
  variables = "P1_005N",
  year = 2020,
  sumfile = "pl"
)
```

```{r}
library(sf)
library(ggplot2)
```


```{r}
ggplot() +
  geom_sf(data = aian_2020,
          aes(fill = value),
          color = "white",
          alpha = 0.7) + 
  scale_fill_distiller(palette = "Purples", direction = 1) +
  theme_void()
```

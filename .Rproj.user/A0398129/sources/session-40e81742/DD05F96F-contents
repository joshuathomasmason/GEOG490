libraries
```{r}
library(tidycensus)
library(tidyverse)
library(tmap)
library(mapview)
library(tigris)
```

use "view" for interactive plot, and "plot" for static
```{r}
tmap_mode("plot")
```

```{r}
md_race = get_decennial(
  geography = "county",
  state = "OR",
  county = "Lane",
  variables = c(
    Hispanic = "P2_002N",
    White = "P2_005N",
    Black = "P2_006N",
    Asian = "P2_008N"
  ),
  year = 2020,
  geometry = TRUE
)
```

```{r}
md_dots = as_dot_density(
  md_race,
  value = "value",
  values_per_dot = 500,
  group = "variable"
)

background_tracts = filter(md_race, variable == "White")
```

```{r}
tm_shape(background_tracts) +
  tm_polygons(col = "white",
              border.col = "grey") +
  tm_shape(md_dots) +
  tm_dots(col = "variable",
          palette = "Set1",
          size = 0.25,
          title = "1 dot = 500 people") +
  tm_layout(legend.outside = TRUE)#,
            #title = "Race/ethnicity, \n2020 US Census", scale =2)
```


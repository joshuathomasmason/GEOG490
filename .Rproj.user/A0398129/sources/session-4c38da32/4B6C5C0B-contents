# Lab 2 Submission Requirements Section: STUDY AREA — STATE OF OREGON COUNTIES

# Loading county data for Oregon
bachelors_25_over <- get_acs(
  geography = "county",
  variables = "DP02_0068P",
  state = "OR",
  year = 2020
)

# 1. Finding county with lowest percentage in Oregon NOTE: Morrow County, 9.1%
arrange(bachelors_25_over, estimate)

# 2. Finding county with highest percentage in Oregon NOTE: Benton County, 53.3%
arrange(bachelors_25_over, desc(estimate))

# 3. Finding median percentage for counties in Oregon NOTE: 21.55%
median(bachelors_25_over$estimate)

# 4. Using different variable B19001_001, total households
# Data from 2020 ACS for analysis of Oregon counties
total_households <- get_acs(
  geography = "county",
  variables = "B19001_001",
  state = "OR",
  year = 2020
)

# Plotting histogram of different variable, total households for Oregon counties 
# NOTE: modal median of 20,000 households
options(scipen = 999)
ggplot(total_households, aes(x = estimate)) +
  geom_histogram(fill = "darkgreen")

# Adding bins to view differences
ggplot(total_households, aes(x = estimate)) +
  geom_histogram(fill = "darkgreen", bins = 60)

# Whisker plot
ggplot(total_households, aes(y = estimate)) +
  geom_boxplot()

# Pyramid plot getting estimate data from census population estimates API
oregon <- get_estimates(
  geography = "state",
  state = "OR",
  product = "characteristics",
  breakdown = c("SEX", "AGEGROUP"),
  breakdown_labels = TRUE,
  year = 2019
)

# Filtering data
oregon_filtered <- filter(oregon, str_detect(AGEGROUP, "Age"),
                          SEX != "Both sexes") %>%
  mutate(value = ifelse(SEX == "Male", -value, value))

# Plotting on Pyramid Plot
ggplot(oregon_filtered, aes(x = value, y = AGEGROUP, fill = SEX)) +
  geom_col() +
  scale_fill_manual(values = c(
    "Male" = "orange",
    "Female" = "purple"
  ))

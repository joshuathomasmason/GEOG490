localg_weights <- nb2listw(include.self(neighbors))
tx_median_income$localG <- localG(tx_median_income$estimate, localg_weights)
numeric_g <- as.numeric(localG(tx_median_income$estimate, localg_weights))
ggplot(tx_median_income) +
geom_sf(aes(fill = numeric_g), color = NA) +
scale_fill_distiller(palette = "RdYlBu") +
theme_void() +
labs(fill = "Local Gi* statistic")
tx_median_income <- tx_median_income %>%
mutate(hotspot = case_when(
localG >= 2.56 ~ "High cluster",
localG <= -2.56 ~ "Low cluster",
TRUE ~ "Not significant"
))
ggplot(tx_median_income) +
geom_sf(aes(fill = hotspot), color = "grey90", size = 0.1) +
scale_fill_manual(values = c("orange", "blue", "grey")) +
theme_void()
ggplot(tx_median_income) +
geom_sf(aes(fill = hotspot), color = "grey90", size = 0.1) +
scale_fill_manual(values = c("orange", "lightblue", "grey")) +
theme_void()
ggplot(tx_median_income) +
geom_sf(aes(fill = hotspot), color = "grey90", size = 0.1) +
scale_fill_manual(values = c("orange", "blue", "grey")) +
theme_void()
View(tx_tracts_recode)
# Tabulating new groups with Hanberry LandScan thresholds
tx_tracts_recode <- tx_tracts_dens %>%
mutate(pop_class = case_when(
between(pop_dens, 0, 550) ~ "Exurban",
between(pop_dens, 550, 1000) ~ "SuburbanLow",
between(pop_dens, 1000, 1900) ~ "SuburbanHigh",
between(pop_dens, 1900, 4500) ~ "UrbanLow",
pop_dens > 4500 ~ "UrbanHigh"
),
pop_class = factor(
pop_class,
levels = c(
"Exurban",
"SuburbanLow",
"SuburbanHigh",
"UrbanLow",
"UrbanHigh"
),
ordered = TRUE # Fixes issue with ggplot putting UrbanHigh before UrbanLow
))
# Map of Hanberry Threshold subgeographies
ggplot(tx_tracts_recode) +
geom_sf(aes(fill = pop_class), color = NA) +
scale_fill_brewer(
palette = "Blues",
direction = 1
) +
theme_void() +
labs(fill = "Hanberry\nPopulation Thresholds")

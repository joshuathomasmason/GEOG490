# Getting ACS Median Household Income
tx_median_income <- get_acs(
geography = "tract",
variables = "B19013_001",
state = "TX",
year = 2020,
geometry = TRUE
) %>%
st_transform(6580) %>%
st_filter(tx_metro, .predicate = st_within) %>%
na.omit()
tx_income_groups <- tx_median_income %>%
mutate(
income_group = case_when(
between(estimate, 0, 10000) ~ "0 to 10,000",
between(estimate, 10000, 25000) ~ "10,000 to 25,000",
between(estimate, 25000, 50000) ~ "25,000 to 50,000",
between(estimate, 50000, 75000) ~ "50,000 to 75,000",
between(estimate, 75000, 100000) ~ "75,000 to 100,000",
between(estimate, 100000, 125000) ~ "100,000 to 125,000",
between(estimate, 125000, 150000) ~ "125,000 to 150,000",
between(estimate, 150000, 200000) ~ "150,000 to 200,000",
between(estimate, 200000, 250000) ~ "200,000 to 250,000",
estimate > 250000 ~ "> 250,000"
)
)
# Plotting income
ggplot(tx_income_groups, aes(x = estimate, y = income_group)) +
geom_col()
# Mapping Median Household Income
ggplot(tx_median_income) +
geom_sf(aes(fill = estimate), color = NA) +
scale_fill_distiller(
palette = "Blues",
direction = 1
) +
theme_void() +
labs(fill = "Median Household\nIncome Estimate")
#-------------------------------------------------------------------------------
# Getting ACS data on people with a Bachelor's degree or higher (Counties)
tx_education <- get_acs(
geography = "county",
variables = c("B15003_022E", "B15003_023E", "B15003_024E", "B15003_025E"),
state = "TX",
year = 2020,
geometry = TRUE
) %>%
st_transform(6580) %>%
st_filter(tx_metro, .predicate = st_within) %>%
na.omit()
tx_education <- tx_education %>%
mutate(
degree = case_when(
variable == "B15003_022" ~ "Bachelor's",
variable == "B15003_023" ~ "Master's",
variable == "B15003_024" ~ "Professional",
variable == "B15003_025" ~ "Doctorate"
)
)
# Horizontal Bar Chart of Education Level in Austin MSA (County Data)
ggplot(tx_education,
aes(x = estimate,
y = reorder(NAME, estimate),
fill = degree)) +
geom_col() +
labs(title = "Education Level in Austin MSA") +
theme_minimal()
